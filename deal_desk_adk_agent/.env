# ============================================================================
# WORKSHOP CONFIGURATION VARIABLES (Edit these values for your GCP project)
# ============================================================================
PROJECT_ID="YOUR_GCP_PROJECT_ID"
REGION="northamerica-northeast2"
VERTEX_ENDPOINT_ID="YOUR_VERTEX_ENDPOINT_ID"
SEARCH_ENGINE_ID="deal-desk-cfo-search-engine"
SEARCH_LOCATION="global"
GEMINI_MODEL="gemini-3.1-pro-preview"

# Gemini Enterprise App ID (Cloud Console -> Gemini Enterprise -> Apps)
GEMINI_ENTERPRISE_APP_ID="deal-desk-gemini-enterprise"
GEMINI_ENTERPRISE_LOCATION="global"

# Cloud Run Sizing
CLOUD_RUN_MIN_INSTANCES="3"
CLOUD_RUN_MAX_INSTANCES="5"
CLOUD_RUN_CPU="4"
CLOUD_RUN_MEMORY="16Gi"

# Hands-On Exercise: Find your deployed 'deal-desk-mcp-server' URL in Cloud Run and paste below
MCP_SERVER_URL="PASTE_YOUR_CLOUD_RUN_MCP_URL_HERE"

# ============================================================================
# GOOGLE ADK / VERTEX AI RUNTIME ENVIRONMENT VARIABLES
# ============================================================================
GOOGLE_GENAI_USE_VERTEXAI="TRUE"
GOOGLE_CLOUD_PROJECT="YOUR_GCP_PROJECT_ID"
GOOGLE_CLOUD_LOCATION="global"
